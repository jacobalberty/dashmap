# Required
DATABASE_URL=postgres://dashmap:dashmap@localhost:5432/dashmap?sslmode=disable

# Required for the worker
VIDEO_ROOT=/path/to/TeslaCam

# Optional — defaults shown
HTTP_ADDR=:8080
DEFAULT_FPS=36
SCAN_INTERVAL=5m
LOG_LEVEL=info      # debug | info | warn | error
LOG_FORMAT=json     # json | text
AUTO_MIGRATE=true
CAR_KEY=default
CAR_DISPLAY_NAME=
SEI_SAMPLE_RATE=1.0
INGEST_CONCURRENCY=  # defaults to runtime.NumCPU()
